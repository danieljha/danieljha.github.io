---
import { render } from "astro:content";
import { getPosts } from "../posts";
import Layout from "../layouts/Layout.astro";
import FireTitle from "../components/FireTitle.astro";
import RecentFilms from "../components/RecentFilms.astro";
import RecentEpisodes from "../components/RecentEpisodes.astro";

const posts = await getPosts();
---

<Layout title="Daniel sin blogg" description="Min personlige Netlifeblogg">
  <FireTitle text="Daniel sin blogg" />
  <p>Min personlige Netlifeblogg</p>
  <hr />

  <RecentFilms />
  <RecentEpisodes />
  <hr />

  <h2>Siste innlegg</h2>
  <div class="space-y-1">
    {posts.map(async (post) => {
      const { Content } = await render(post);
      const { title, pubDate } = post.data;
      return (
        <article
          id={post.id}
          class="p-2 text-ink bg-linear-to-t from-paper to-white/50 border shadow"
        >
          <h3 class="m-0">{title}</h3>
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString("no", { timeZone: "Europe/Oslo" })}
          </time>

          <Content />
        </article>
      );
    })}
  </div>
</Layout>
